# Copiar a .env.local. Valores en Supabase → Project Settings → API Keys.
# La publishable va al navegador. La secret / service_role solo en el servidor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Web Push. Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:asesor@ejemplo.cl

# Secreto propio para GET /api/cron/alertas. Generar con: openssl rand -base64 32
CRON_SECRET=

# Webhook de leads. Generar con: openssl rand -base64 32
# Si hay más de un usuario en Auth, LEADS_ASESOR_ID es el uuid del asesor que recibe los leads.
LEADS_WEBHOOK_SECRET=
LEADS_ASESOR_ID=

# La cuenta de Google Ads no va aquí. Cada asesor la guarda en la pantalla Google Ads.

# Mercado Pago (Tus integraciones → tu aplicación → Credenciales). Usa las de prueba en desarrollo.
# MP_WEBHOOK_SECRET es la "clave secreta" de Webhooks. URL a registrar: {APP_URL}/api/v1/webhooks/mercadopago
# Eventos: Planes y suscripciones (subscription_preapproval, subscription_authorized_payment) y Pagos.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# URL pública de la app, sin / final. Mercado Pago vuelve a {APP_URL}/suscripcion.
APP_URL=

# Email del super admin (panel /admin). Solo servidor.
SUPER_ADMIN_EMAIL=

# Tres hosts del mismo servicio. Sin estas variables, la URL actual sirve la app y /admin juntos.
# LANDING_HOST=velora.cl          sitio público
# APP_HOST=admin.velora.cl        escritorio de los asesores
# OWNER_HOST=panel.velora.cl      panel del dueño (suscripciones y asesores)
LANDING_HOST=
APP_HOST=
OWNER_HOST=
